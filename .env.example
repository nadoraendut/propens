# Copy to .env and fill in. Never commit .env.

# Public DNS name users will type, e.g. audit.uitm.edu.my  (used by the HTTPS proxy)
DOMAIN=audit.example.edu.my

# Outgoing e-mail. Leave SMTP_HOST empty to only record e-mails in the admin Outbox page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
MAIL_FROM=audit@example.edu.my

# Optional: fixed secret for signing sessions. If empty a random one is created once and kept in the data volume.
# SECRET_KEY=
